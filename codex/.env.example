# =============================================================
# VisualGroups — variables de entorno (plantilla)
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` NO se versiona (ver .gitignore).
# =============================================================

# Supabase (cliente browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NO usar `service_role` en cliente. La service key vive solo en Edge
# Functions de Supabase, nunca en este repo de frontend.
