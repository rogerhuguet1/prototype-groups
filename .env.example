# =============================================================
# VisualGroups — variables de entorno (plantilla)
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` NO se versiona (ver .gitignore).
# =============================================================

# --- Supabase (preparado, NO se usa en el prototipo Fase 0) ---
# La app del prototipo trabaja con datos mock. Estas variables están
# declaradas para que el cambio a Supabase real sea sólo: rellenar valores
# y reemplazar el stub de `lib/supabase/client.ts`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NO usar `service_role` en cliente. La service key vive sólo en Edge
# Functions de Supabase, nunca en este repo de frontend.
